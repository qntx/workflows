{
  "contract": "qntx/release-assets",
  "version": 1,
  "description": "Producer-side naming contract for GitHub Release assets published by qntx/workflows release-rust.yml and parsed by installers such as qntx/sh. Parse a name only together with the expected <bin> and <version> (the tag without its leading v).",
  "grammar": "<bin>-<version>[-<variant>]-<target>.<ext>",
  "patterns": {
    "bin": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
    "version": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$",
    "variant": "^[a-z][a-z0-9]*$"
  },
  "targets": [
    {
      "triple": "x86_64-unknown-linux-gnu",
      "archive": "tar.gz"
    },
    {
      "triple": "aarch64-unknown-linux-gnu",
      "archive": "tar.gz"
    },
    {
      "triple": "x86_64-unknown-linux-musl",
      "archive": "tar.gz"
    },
    {
      "triple": "aarch64-unknown-linux-musl",
      "archive": "tar.gz"
    },
    {
      "triple": "aarch64-apple-darwin",
      "archive": "tar.gz"
    },
    {
      "triple": "x86_64-pc-windows-msvc",
      "archive": "zip"
    },
    {
      "triple": "aarch64-pc-windows-msvc",
      "archive": "zip"
    }
  ],
  "assets": [
    {
      "kind": "archive",
      "name": "<bin>-<version>[-<variant>]-<target>.<archive>",
      "required": true,
      "description": "Installable archive; <archive> is the target's archive extension."
    },
    {
      "kind": "sha256",
      "name": "<bin>-<version>[-<variant>]-<target>.<archive>.sha256",
      "required": true,
      "description": "Required for every archive: one line, 64 lowercase hex digits, two spaces, the bare archive name, newline (sha256sum text mode)."
    },
    {
      "kind": "sbom",
      "name": "<bin>-<version>[-<variant>]-<target>.cdx.json",
      "required": false,
      "description": "Optional CycloneDX JSON SBOM of the binary in the matching archive."
    },
    {
      "kind": "aggregate",
      "name": "SHA256SUMS",
      "required": false,
      "description": "Optional; outside the <bin>-<version>- namespace. One sha256sum text-mode line per archive."
    }
  ],
  "rules": [
    "SHA256SUMS is the aggregate checksum file.",
    "Any other name that does not start with '<bin>-<version>-' is outside the namespace and is ignored.",
    "Inside the namespace, strip the '<bin>-<version>-' prefix, then the suffix: '.cdx.json' (sbom), '.<archive>.sha256' (sha256) or '.<archive>' (archive).",
    "The remaining stem must be '<target>' or '<variant>-<target>', where <target> is a listed triple matched as a suffix and <variant> matches patterns.variant.",
    "<archive> must be the extension listed for that target.",
    "A name inside the namespace that does not parse is naming drift: fail loudly rather than skip it."
  ],
  "layout": {
    "description": "Where the binary sits inside an archive. Exactly one of the listed members must exist and be a regular file (executable in tar.gz). No link entries, no absolute paths, no '..' components. <stem> is the archive name without '.<archive>'; <bin> is the binary name (Windows adds .exe).",
    "members": {
      "tar.gz": [
        "./<bin>",
        "<stem>/<bin>"
      ],
      "zip": [
        "<bin>.exe",
        "<stem>/<bin>.exe"
      ]
    }
  },
